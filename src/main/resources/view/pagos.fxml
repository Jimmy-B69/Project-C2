<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10.0" styleClass="modulo" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.alquileres.controller.PagoController">

    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Label styleClass="titulo-modulo" text="Gestión de Pagos" />
        <Region HBox.hgrow="ALWAYS" />
        <Label styleClass="campo-etiqueta" text="Buscar:" />
        <TextField fx:id="txtBuscar" prefWidth="190.0" promptText="Inquilino, depto. o periodo" />
        <ComboBox fx:id="cbxFiltroMetodo" prefWidth="150.0" />
    </HBox>

    <HBox spacing="12.0" VBox.vgrow="ALWAYS">
        <VBox prefWidth="350.0" spacing="8.0">
            <Label fx:id="lblFormTitulo" styleClass="titulo-form" text="Registrar pago" />

            <GridPane hgap="8.0" vgap="7.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="75.0" prefWidth="100.0" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>

                <Label styleClass="campo-etiqueta" text="Contrato *" GridPane.rowIndex="0" />
                <ComboBox fx:id="cbxContrato" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label styleClass="campo-etiqueta" text="Fecha pago *" GridPane.rowIndex="1" />
                <DatePicker fx:id="dpFechaPago" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label styleClass="campo-etiqueta" text="Periodo *" GridPane.rowIndex="2" />
                <DatePicker fx:id="dpPeriodo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label styleClass="campo-etiqueta" text="Monto (S/) *" GridPane.rowIndex="3" />
                <TextField fx:id="txtMonto" maxWidth="Infinity" promptText="Ej. 650.00" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label styleClass="campo-etiqueta" text="Método *" GridPane.rowIndex="4" />
                <ComboBox fx:id="cbxMetodo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <Label styleClass="campo-etiqueta" text="Descuento" GridPane.rowIndex="5" />
                <TextField fx:id="txtDescuento" maxWidth="Infinity" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                <Label styleClass="campo-etiqueta" text="IGV" GridPane.rowIndex="6" />
                <TextField fx:id="txtIgv" maxWidth="Infinity" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="6" />
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>

            <Label fx:id="lblInfoContrato" styleClass="texto-ayuda" text="Selecciona un contrato para ver el monto." wrapText="true" />
            <Label fx:id="lblMensaje" wrapText="true" />

            <Region VBox.vgrow="ALWAYS" />

            <HBox spacing="8.0">
                <Button maxWidth="Infinity" onAction="#onGuardar" styleClass="boton-primario" text="Guardar" HBox.hgrow="ALWAYS" />
                <Button maxWidth="Infinity" onAction="#onCancelar" styleClass="boton-secundario" text="Cancelar" HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>

        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Button onAction="#onNuevo" styleClass="boton-secundario" text="Nuevo" />
                <Button onAction="#onEliminar" styleClass="boton-peligro" text="Eliminar" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblConteo" styleClass="texto-conteo" text="0 registros" />
            </HBox>

            <TableView fx:id="tblPagos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="50.0" text="#" />
                    <TableColumn fx:id="colFecha" prefWidth="90.0" text="Fecha" />
                    <TableColumn fx:id="colPeriodo" prefWidth="110.0" text="Periodo" />
                    <TableColumn fx:id="colInquilino" prefWidth="170.0" text="Inquilino" />
                    <TableColumn fx:id="colDepartamento" prefWidth="65.0" text="Depto." />
                    <TableColumn fx:id="colMonto" prefWidth="100.0" text="Monto" />
               <TableColumn fx:id="colDescuento" prefWidth="75.0" text="Descuento" />
                    <TableColumn fx:id="colMetodo" prefWidth="110.0" text="Método" />
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>
