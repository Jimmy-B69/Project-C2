<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.alquileres.controller.PagoController"
      styleClass="modulo" spacing="10.0">

    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Label text="Gestión de Pagos" styleClass="titulo-modulo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Buscar:" styleClass="campo-etiqueta"/>
        <TextField fx:id="txtBuscar" promptText="Inquilino, depto. o periodo" prefWidth="190.0"/>
        <ComboBox fx:id="cbxFiltroMetodo" prefWidth="150.0"/>
    </HBox>

    <HBox spacing="12.0" VBox.vgrow="ALWAYS">
        <VBox prefWidth="350.0" spacing="8.0">
            <Label fx:id="lblFormTitulo" text="Registrar pago" styleClass="titulo-form"/>

            <GridPane hgap="8.0" vgap="7.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="75.0" prefWidth="100.0"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Contrato *" styleClass="campo-etiqueta" GridPane.rowIndex="0"/>
                <ComboBox fx:id="cbxContrato" maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Fecha pago *" styleClass="campo-etiqueta" GridPane.rowIndex="1"/>
                <DatePicker fx:id="dpFechaPago" maxWidth="Infinity"
                            GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Periodo *" styleClass="campo-etiqueta" GridPane.rowIndex="2"/>
                <DatePicker fx:id="dpPeriodo" maxWidth="Infinity"
                            GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Monto (S/) *" styleClass="campo-etiqueta" GridPane.rowIndex="3"/>
                <TextField fx:id="txtMonto" promptText="Ej. 650.00" maxWidth="Infinity"
                           GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Método *" styleClass="campo-etiqueta" GridPane.rowIndex="4"/>
                <ComboBox fx:id="cbxMetodo" maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <Label text="Descuento" styleClass="campo-etiqueta" GridPane.rowIndex="5"/>
                <TextField fx:id="txtDescuento" promptText="0.00" maxWidth="Infinity"
                           GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                <Label text="IGV" styleClass="campo-etiqueta" GridPane.rowIndex="6"/>
                <TextField fx:id="txtIgv" promptText="0.00" maxWidth="Infinity"
                           GridPane.columnIndex="1" GridPane.rowIndex="6"/>
            </GridPane>

            <Label fx:id="lblInfoContrato" text="Selecciona un contrato para ver el monto."
                   styleClass="texto-ayuda" wrapText="true"/>
            <Label fx:id="lblMensaje" wrapText="true"/>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox spacing="8.0">
                <Button text="Guardar" onAction="#onGuardar" styleClass="boton-primario"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button text="Cancelar" onAction="#onCancelar" styleClass="boton-secundario"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Button text="Nuevo" onAction="#onNuevo" styleClass="boton-secundario"/>
                <Button text="Eliminar" onAction="#onEliminar" styleClass="boton-peligro"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblConteo" text="0 registros" styleClass="texto-conteo"/>
            </HBox>

            <TableView fx:id="tblPagos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="#" prefWidth="50.0"/>
                    <TableColumn fx:id="colFecha" text="Fecha" prefWidth="90.0"/>
                    <TableColumn fx:id="colPeriodo" text="Periodo" prefWidth="110.0"/>
                    <TableColumn fx:id="colInquilino" text="Inquilino" prefWidth="170.0"/>
                    <TableColumn fx:id="colDepartamento" text="Depto." prefWidth="65.0"/>
                    <TableColumn fx:id="colMonto" text="Monto" prefWidth="100.0"/>
                    <TableColumn fx:id="colMetodo" text="Método" prefWidth="110.0"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>
