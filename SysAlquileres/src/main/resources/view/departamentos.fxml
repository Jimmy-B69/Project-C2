<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.alquileres.controller.DepartamentoController"
      styleClass="modulo" spacing="10.0">

    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Label text="Gestión de Departamentos" styleClass="titulo-modulo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Buscar:" styleClass="campo-etiqueta"/>
        <TextField fx:id="txtBuscar" promptText="Número o dirección" prefWidth="200.0"/>
        <ComboBox fx:id="cbxFiltroEstado" prefWidth="150.0"/>
    </HBox>

    <HBox spacing="12.0" VBox.vgrow="ALWAYS">
        <VBox prefWidth="330.0" spacing="8.0">
            <Label fx:id="lblFormTitulo" text="Nuevo departamento" styleClass="titulo-form"/>

            <GridPane hgap="8.0" vgap="8.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="70.0" prefWidth="95.0"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Número *" styleClass="campo-etiqueta" GridPane.rowIndex="0"/>
                <TextField fx:id="txtNumero" promptText="Ej. 101" maxWidth="Infinity"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Piso *" styleClass="campo-etiqueta" GridPane.rowIndex="1"/>
                <TextField fx:id="txtPiso" promptText="Ej. 1" maxWidth="Infinity"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Dirección *" styleClass="campo-etiqueta" GridPane.rowIndex="2"/>
                <TextField fx:id="txtDireccion" promptText="Ej. Jr. San Martin 120" maxWidth="Infinity"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Precio (S/) *" styleClass="campo-etiqueta" GridPane.rowIndex="3"/>
                <TextField fx:id="txtPrecio" promptText="Ej. 650.00" maxWidth="Infinity"
                           GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            </GridPane>

            <Label fx:id="lblMensaje" wrapText="true"/>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox spacing="8.0">
                <Button text="Guardar" onAction="#onGuardar" styleClass="boton-primario"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button text="Cancelar" onAction="#onCancelar" styleClass="boton-secundario"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Button text="Nuevo" onAction="#onNuevo" styleClass="boton-secundario"/>
                <Button text="Eliminar" onAction="#onEliminar" styleClass="boton-peligro"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblConteo" text="0 registros" styleClass="texto-conteo"/>
            </HBox>

            <TableView fx:id="tblDepartamentos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNumero" text="N°" prefWidth="70.0"/>
                    <TableColumn fx:id="colPiso" text="Piso" prefWidth="60.0"/>
                    <TableColumn fx:id="colDireccion" text="Dirección" prefWidth="260.0"/>
                    <TableColumn fx:id="colPrecio" text="Precio mensual" prefWidth="130.0"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="110.0"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>
