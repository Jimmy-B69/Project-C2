<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.alquileres.controller.InquilinoController"
      styleClass="modulo" spacing="10.0">

    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Label text="Gestión de Inquilinos" styleClass="titulo-modulo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Buscar:" styleClass="campo-etiqueta"/>
        <TextField fx:id="txtBuscar" promptText="DNI, nombre o apellido" prefWidth="190.0"/>
        <ComboBox fx:id="cbxFiltroTipo" prefWidth="140.0"/>
    </HBox>

    <HBox spacing="12.0" VBox.vgrow="ALWAYS">
        <VBox prefWidth="340.0" spacing="8.0">
            <Label fx:id="lblFormTitulo" text="Nuevo inquilino" styleClass="titulo-form"/>

            <GridPane hgap="8.0" vgap="7.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="70.0" prefWidth="95.0"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="DNI *" styleClass="campo-etiqueta" GridPane.rowIndex="0"/>
                <TextField fx:id="txtDni" promptText="8 dígitos" maxWidth="Infinity"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Nombre *" styleClass="campo-etiqueta" GridPane.rowIndex="1"/>
                <TextField fx:id="txtNombre" maxWidth="Infinity"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Apellido *" styleClass="campo-etiqueta" GridPane.rowIndex="2"/>
                <TextField fx:id="txtApellido" maxWidth="Infinity"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Teléfono" styleClass="campo-etiqueta" GridPane.rowIndex="3"/>
                <TextField fx:id="txtTelefono" maxWidth="Infinity"
                           GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Dirección" styleClass="campo-etiqueta" GridPane.rowIndex="4"/>
                <TextField fx:id="txtDireccion" maxWidth="Infinity"
                           GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <Label text="Personería *" styleClass="campo-etiqueta" GridPane.rowIndex="5"/>
                <ComboBox fx:id="cbxTipoPersoneria" maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="5"/>
            </GridPane>

            <VBox fx:id="boxLegal" spacing="7.0" visible="false" managed="false">
                <Label text="Datos de la empresa" styleClass="titulo-form"/>
                <GridPane hgap="8.0" vgap="7.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="70.0" prefWidth="95.0"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Rep. legal" styleClass="campo-etiqueta" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtRepLegal" maxWidth="Infinity"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="RUC" styleClass="campo-etiqueta" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtRuc" promptText="10 u 11 dígitos" maxWidth="Infinity"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Dir. fiscal" styleClass="campo-etiqueta" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtDireccionFiscal" maxWidth="Infinity"
                               GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                </GridPane>
            </VBox>

            <Label fx:id="lblMensaje" wrapText="true"/>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox spacing="8.0">
                <Button text="Guardar" onAction="#onGuardar" styleClass="boton-primario"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button text="Cancelar" onAction="#onCancelar" styleClass="boton-secundario"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Button text="Nuevo" onAction="#onNuevo" styleClass="boton-secundario"/>
                <Button text="Eliminar" onAction="#onEliminar" styleClass="boton-peligro"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblConteo" text="0 registros" styleClass="texto-conteo"/>
            </HBox>

            <TableView fx:id="tblInquilinos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colDni" text="DNI" prefWidth="85.0"/>
                    <TableColumn fx:id="colNombre" text="Nombre completo" prefWidth="190.0"/>
                    <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="100.0"/>
                    <TableColumn fx:id="colTipo" text="Personería" prefWidth="100.0"/>
                    <TableColumn fx:id="colDireccion" text="Dirección" prefWidth="220.0"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>
